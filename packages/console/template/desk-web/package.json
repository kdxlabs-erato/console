{
  "name": "desk-web",
  "version": "0.1.0",
  "private": true,
  "description": "The pages of my desk: a console of my own, served from this machine by console serve.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --logLevel warn",
    "serve": "console serve dist --records ../records"
  },
  "dependencies": {
    "@skillcdn/console": "__VERSION__",
    "pretendard": "1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
