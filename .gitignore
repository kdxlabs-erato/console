# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
dist/
*.tsbuildinfo
.turbo/
coverage/

# Secrets: real values never enter git. `.env.example` is the only env file tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
secrets/

# Infrastructure state. Infra lives outside this repo; guard against accidents anyway.
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
cdk.out/

# Local data (compose volumes, scratch files)
.data/
tmp/

# Logs
*.log

# What is copied next to the package while it is packed (scripts/pack-files.mjs)
packages/*/LICENSE.md
packages/*/SKILLCDN.md
packages/*/skills/
packages/*/docs/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent tooling: personal overrides stay local
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# The console binding `console use` writes: it names an organization's console, and this repository is public
.skillcdn-console.json

# The packs an organization mounts into the smallest install (deploy/compose.yaml): its own, never committed
deploy/packs/
